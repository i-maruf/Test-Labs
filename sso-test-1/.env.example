# local  = Docker identity provider (works with no Azure account)
# microsoft = real Microsoft Entra ID (requires an app registration)
OIDC_PROVIDER=local

MICROSOFT_CLIENT_ID=sso-test-1-web
MICROSOFT_CLIENT_SECRET=sso-test-1-web-secret
MICROSOFT_TENANT_ID=common

OIDC_ISSUER=http://localhost:8080/oidc
OIDC_ISSUER_INTERNAL=http://idp:5000/oidc
REDIRECT_URI=http://localhost:8080/auth/callback

APP_SECRET_KEY=change-this-to-a-long-random-string
SESSION_COOKIE_SECURE=false
